VITE_FB_API_KEY=
VITE_FB_AUTH=
VITE_FB_PROJECT=
# URL assoluto della Cloud Function lookupAic (opzionale, build-time).
# Se vuoto, l'app prova same-origin /api/lookupAic (Firebase Hosting rewrite)
# e poi il fallback locale. Esempio:
# VITE_AIFA_FN_URL=https://europe-west1-TUO_PROJECT.cloudfunctions.net/lookupAic
